tenant_id       = "19767c7d-34c4-415c-9a1d-45ccfb89a3dd"
subscription_id = "5e3f35c0-0fe2-40db-a778-723c73670c4c"

# Stable user principal that can manage Key Vault secrets locally.
key_vault_secrets_officer_principal_id = "2e151b35-6a85-47e8-855f-4b4623a7cd62"

project_name = "nueva-era"
environment  = "prod"
location     = "eastus"

# eastus is currently restricted for this subscription's PostgreSQL Flexible Server
# and saturated for Container Apps Environment capacity. Keep RG/Key Vault in eastus,
# but place the workload pieces in eastus2.
container_apps_location = "eastus2"
postgres_location       = "eastus2"

# Cheapest starting database. For heavier real production use, consider B_Standard_B2s.
postgres_sku_name   = "B_Standard_B1ms"
postgres_storage_mb = 32768
postgres_zone       = "1"

# Allows PostgreSQL access from any public IP. Login/password are still required.
allow_public_networks_to_postgres = true

# 0 is cheapest and can cold-start. Use 1 if the API must stay warm.
container_min_replicas = 0
container_max_replicas = 2
container_cpu          = 0.5
container_memory       = "1Gi"
container_target_port  = 3000

# Keep this false when GitHub Actions builds and pushes the image.
build_backend_image = false

# Optional: allow local/admin public IPs to reach PostgreSQL.
# postgres_allowed_ip_ranges = {
#   office = {
#     start = "1.2.3.4"
#     end   = "1.2.3.4"
#   }
# }
